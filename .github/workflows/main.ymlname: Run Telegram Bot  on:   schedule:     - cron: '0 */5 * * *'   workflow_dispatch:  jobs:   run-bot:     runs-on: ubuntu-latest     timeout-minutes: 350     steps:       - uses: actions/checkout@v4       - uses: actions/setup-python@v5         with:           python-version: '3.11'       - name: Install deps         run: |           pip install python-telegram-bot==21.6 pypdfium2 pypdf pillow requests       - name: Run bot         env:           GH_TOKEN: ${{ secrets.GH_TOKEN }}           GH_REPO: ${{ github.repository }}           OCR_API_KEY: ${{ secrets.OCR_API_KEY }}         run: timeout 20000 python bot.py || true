def extract_data_from_text(full_text):
    """Barreeffama irraa odeeffannoo baasuu"""
    data = {}
    if not full_text: return data

    # Maqaa Amaaraa
    m = re.search(r"[\u1200-\u137F]{2,}(?:\s+[\u1200-\u137F]{2,})+", full_text)
    if m: data['name_am'] = m.group(0).strip()

    # Maqaa Ingiliffa
    m = re.search(r"([A-Z][a-z]+\s+[A-Z][a-z]+\s+[A-Z][a-z]+(?:\s+[A-Z][a-z]+)?)", full_text)
    if m: data['name_en'] = m.group(1)

    # Guyyaa
    m = re.search(r"(\d{2}/\d{2}/\d{4})\s+(\d{2}/\d{2}/\d{4})", full_text)
    if m:
        data['dob'] = m.group(1); data['date_issue'] = m.group(2)
    else:
        m = re.search(r"(\d{2}/\d{2}/\d{4})", full_text)
        if m: data['dob'] = m.group(1)

    # Saala
    m = re.search(r"\b(Male|Female|ወንድ|ሴት)\b", full_text)
    if m: data['sex'] = m.group(1)

    # Naannoo
    m = re.search(r"\b(Oromia|Amhara|Tigray|Somali|Afar|Benishangul|Gambela|Harari|SNNPR|Sidama|South West|Addis Ababa|Dire Dawa)\b",
                  full_text, re.IGNORECASE)
    if m: data['region'] = m.group(1)

    # Bilbila
    m = re.search(r"\b(09\d{8}|07\d{8}|\+251\d{9})\b", full_text)
    if m: data['phone'] = m.group(1)

    # Lammummaa
    m = re.search(r"\b(Ethiopian)\b", full_text, re.IGNORECASE)
    if m: data['nationality'] = m.group(1)

    # FIN
    m = re.search(r"FIN:?\s*(\d+)", full_text, re.IGNORECASE)
    if m: data['fin'] = m.group(1)

    # FAN
    m = re.search(r"FAN:?\s*(\d{16})", full_text, re.IGNORECASE)
    if not m:
        m = re.search(r"\b(\d{16})\b", full_text)
    if m: data['fan'] = m.group(1)

    return data

# ==================== IMAGE PROCESSING ====================
def prepare_photo(photo_path, target_size, color_mode='color', mirror=False):
    with Image.open(photo_path).convert("RGB") as img:
        if mirror:
            img = img.transpose(Image.FLIP_LEFT_RIGHT)
        target_w, target_h = target_size
        target_ratio = target_w / target_h
        w, h = img.size
        if w / h > target_ratio:
            new_w = int(h * target_ratio)
            left = (w - new_w) // 2
            img = img.crop((left, 0, left + new_w, h))
        else:
            new_h = int(w / target_ratio)
            top = (h - new_h) // 2
            img = img.crop((0, top, w, top + new_h))
        resized = img.resize((target_w, target_h), Image.Resampling.LANCZOS)
        resized = ImageEnhance.Sharpness(resized).enhance(2.0)
        resized = ImageEnhance.Contrast(resized).enhance(1.2)
        if color_mode == 'gray':
            resized = resized.convert('L').convert('RGB')
        else:
            resized = ImageEnhance.Color(resized).enhance(1.1)
            resized = resized.filter(ImageFilter.SMOOTH_MORE)
        return resized

