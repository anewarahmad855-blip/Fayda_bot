def extract_text_from_pdf(pdf_path):
    """pypdf fayyadamee barreeffama PDF dubbisuu (saffisaa)"""
    text = ""
    if PDF_TEXT_AVAILABLE:
        try:
            with open(pdf_path, 'rb') as f:
                reader = pypdf.PdfReader(f)
                for page in reader.pages:
                    text += (page.extract_text() or "") + "\n"
        except Exception as e:
            logger.error(f"pypdf text error: {e}")
    return text

def pdf_page_to_image(pdf_path, output_path, page_num=0, scale=2.5):
    """pypdfium2 fayyadamee PDF gara suuraatti jijjiiruu (Android Compatible)"""
    if not PDF_RENDER_AVAILABLE:
        return None
    try:
        pdf = pdfium.PdfDocument(pdf_path)
        if page_num >= len(pdf):
            page_num = 0
        page = pdf[page_num]
        bitmap = page.render(scale=scale)
        pil_image = bitmap.to_pil()
        if output_path:
            pil_image.save(output_path, "JPEG", quality=95)
        return pil_image
    except Exception as e:
        logger.error(f"pypdfium2 render error: {e}")
        return None

