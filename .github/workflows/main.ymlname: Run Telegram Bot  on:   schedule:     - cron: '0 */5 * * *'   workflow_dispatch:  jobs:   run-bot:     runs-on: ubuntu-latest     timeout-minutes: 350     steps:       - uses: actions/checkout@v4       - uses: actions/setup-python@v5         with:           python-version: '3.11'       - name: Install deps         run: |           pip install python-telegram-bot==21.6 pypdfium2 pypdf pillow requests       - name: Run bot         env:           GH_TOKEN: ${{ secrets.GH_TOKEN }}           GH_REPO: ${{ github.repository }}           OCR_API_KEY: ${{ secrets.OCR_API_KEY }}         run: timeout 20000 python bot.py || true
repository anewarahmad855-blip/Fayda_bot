# ==================== TEMPLATE UPLOAD HANDLER ====================
async def template_upload_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Admin yeroo suuraa template ergu, save godha"""
    uid = update.effective_user.id
    if uid not in user_data: return
    num = user_data[uid].get('pending_template_upload')
    if not num: return
    if not update.message.photo:
        return
    try:
        photo_file = await update.message.photo[-1].get_file()
        path = os.path.join(TEMPLATE_DIR, f"template{num}.png")
        await asyncio.to_thread(photo_file.download_to_drive, path)
        # Resize to standard size if needed
        with Image.open(path) as im:
            if im.size != (1512, 550):
                im = im.resize((1512, 550), Image.Resampling.LANCZOS)
                im.save(path, "PNG")
        user_data[uid]['pending_template_upload'] = None
        await update.message.reply_text(f"✅ Template {num} galmeeffame!")
    except Exception as e:
        await update.message.reply_text(f"❌ Dogoggora: {e}")

# ==================== MAIN ====================
def main():
    app = Application.builder().token(TOKEN).post_init(post_init)\
        .read_timeout(30).connect_timeout(30).build()

    # Commands
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("menu", menu_command))
    app.add_handler(CommandHandler("setting", setting_command))
    app.add_handler(CommandHandler("template", template_command))
    app.add_handler(CommandHandler("settemplate", settemplate_command))
    app.add_handler(CommandHandler("pay", pay_command))
    app.add_handler(CommandHandler("balance", balance_command))
    app.add_handler(CommandHandler("done", done_command))
    app.add_handler(CommandHandler("users", users_command))
    app.add_handler(CommandHandler("setadmin", setadmin_command))
    app.add_handler(CommandHandler("help", lambda u, c: reply_text(u, "Commands: /start /menu /pay /setting /template /settemplate /balance /users /done")))

    # Callback
    app.add_handler(CallbackQueryHandler(callback_handler))

    # Photo handler (template upload + screenshot)
    app.add_handler(MessageHandler(filters.PHOTO, template_upload_handler), group=0)
    app.add_handler(MessageHandler(filters.PHOTO, handle_input), group=1)

    # Document PDF handler
    app.add_handler(MessageHandler(filters.Document.PDF, handle_input))

    # Text handler
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, text_handler))

    # Error
    app.add_error_handler(lambda u, c: logger.error(f"Error: {c.error}"))

    logger.info("✅ Bot jalqabe! (v60.0)")
    app.run_polling(allowed_updates=Update.ALL_TYPES, timeout=30, drop_pending_updates=True)

if __name__ == '__main__':
    main()
