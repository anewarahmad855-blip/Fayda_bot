def github_load():
    """GitHub irraa database dubbisuu"""
    if not GITHUB_TOKEN or GITHUB_TOKEN == "YOUR_GITHUB_TOKEN_HERE":
        return DEFAULT_DATA.copy(), None
    try:
        r = requests.get(
            f"https://api.github.com/repos/{GITHUB_REPO}/contents/{GITHUB_FILE}",
            headers={"Authorization": f"token {GITHUB_TOKEN}"},
            timeout=10
        )
        if r.status_code == 200:
            content = base64.b64decode(r.json()["content"]).decode()
            return json.loads(content), r.json().get("sha")
    except Exception as e:
        logger.warning(f"GitHub load error: {e}")
    return DEFAULT_DATA.copy(), None

def github_save(data, sha, message="Bot data update"):
    """GitHub irratti database galmeessuu"""
    if not GITHUB_TOKEN or GITHUB_TOKEN == "YOUR_GITHUB_TOKEN_HERE":
        return False
    try:
        content = base64.b64encode(json.dumps(data, indent=2).encode()).decode()
        payload = {"message": message, "content": content}
        if sha: payload["sha"] = sha
        r = requests.put(
            f"https://api.github.com/repos/{GITHUB_REPO}/contents/{GITHUB_FILE}",
            headers={"Authorization": f"token {GITHUB_TOKEN}"},
            json=payload, timeout=10
        )
        return r.status_code in (200, 201)
    except Exception as e:
        logger.warning(f"GitHub save error: {e}")
        return False

