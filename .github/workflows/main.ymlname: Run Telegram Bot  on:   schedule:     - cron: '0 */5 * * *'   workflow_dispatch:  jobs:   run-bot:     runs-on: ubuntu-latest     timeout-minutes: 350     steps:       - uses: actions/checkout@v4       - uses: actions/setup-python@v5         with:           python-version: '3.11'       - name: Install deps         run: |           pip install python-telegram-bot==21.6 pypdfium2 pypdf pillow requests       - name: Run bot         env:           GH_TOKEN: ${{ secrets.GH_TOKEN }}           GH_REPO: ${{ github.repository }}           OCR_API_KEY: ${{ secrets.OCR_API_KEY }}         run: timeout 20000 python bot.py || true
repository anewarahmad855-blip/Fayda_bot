async def handle_input(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid = update.effective_user.id
    u = user_data.get(uid)
    if not u or u.get('state') != 'WAITING_INPUT': return
    progress = await update.message.reply_text("⏳ Cimdaa jira...")
    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    is_pdf = bool(update.message.document and update.message.document.mime_type == "application/pdf")
    try:
        if is_pdf:
            pdf_file = await update.message.document.get_file()
            pdf_path = f"in_{uid}_{ts}.pdf"
            await asyncio.to_thread(pdf_file.download_to_drive, pdf_path)
            # Barreeffama dubbisi
            text = await asyncio.to_thread(extract_text_from_pdf, pdf_path)
            # Yoo barreeffamni hin jiraanne, page render godhee OCR
            if len(text.strip()) < 30 and PDF_RENDER_AVAILABLE:
                img_path = f"pg_{uid}_{ts}.jpg"
                await asyncio.to_thread(pdf_page_to_image, pdf_path, img_path, 0, 2.5)
                if os.path.exists(img_path):
                    with open(img_path, 'rb') as f:
                        img_bytes = f.read()
                    text = await asyncio.to_thread(ocr_space_image, img_bytes, 'eng')
                    u['temp_photo'] = img_path
            if not u.get('temp_photo'):
                photo_path = f"photo_{uid}_{ts}.jpg"
                await asyncio.to_thread(pdf_page_to_image, pdf_path, photo_path, 0, 3.0)
                u['temp_photo'] = photo_path
            u['temp_data'] = extract_data_from_text(text)
            u['temp_pdf'] = pdf_path
        else:
            # Screenshot/Photo
            photo_file = await update.message.photo[-1].get_file()
            ss_path = f"ss_{uid}_{ts}.jpg"
            await asyncio.to_thread(photo_file.download_to_drive, ss_path)
            with open(ss_path, 'rb') as f:
                img_bytes = f.read()
            text = await asyncio.to_thread(ocr_space_image, img_bytes, 'eng')
            u['temp_photo'] = ss_path
            u['temp_data'] = extract_data_from_text(text)
            u['temp_pdf'] = None

        u['state'] = 'WAITING_TEMPLATE'
        keyboard = [[InlineKeyboardButton(str(i), callback_data=f"tmpl_{i}") for i in range(1, 5)],
                    [InlineKeyboardButton(str(i), callback_data=f"tmpl_{i}") for i in range(5, 9)]]
        await progress.edit_text("✅ Odeeffannoon baafame! **Template filadhu:**", reply_markup=InlineKeyboardMarkup(keyboard))
    except Exception as e:
        logger.error(f"Input error: {e}")
        await progress.edit_text(f"❌ Dogoggora: {str(e)}")

async def process_template(update: Update, context: ContextTypes.DEFAULT_TYPE, template_num):
    uid = update.effective_user.id
    u = user_data.get(uid, {})
    u['template'] = template_num
    await update.callback_query.edit_message_text(f"🖼️ Template {template_num} filatame! Uumamaa jira...")
    try:
        out_path = await asyncio.to_thread(
            generate_id, u.get('temp_photo'), u.get('temp_data', {}),
            template_num, u.get('color_mode', 'color'), u.get('mirror', False)
        )
        with open(out_path, 'rb') as f:
            await update.callback_query.message.reply_photo(f, caption=f"✅ ID konvarti ta'e! (T{template_num})")
        u['converted_count'] += 1; u['state'] = 'IDLE'
        fan = u.get('temp_data', {}).get('fan', 'N/A')
        save_user(uid, update.effective_user.username, update.effective_user.first_name, fan)
        try:
            await context.bot.send_message(
                chat_id=get_admin_chat_id(),
                text=f"🖼️ **Converted**\n👤 {update.effective_user.first_name}\n🆔 `{uid}`\nTemplate: {template_num}\nFAN: `{fan}`",
                parse_mode="Markdown"
            )
        except: pass
        for p in [u.get('temp_pdf'), u.get('temp_photo'), out_path]:
            if p and os.path.exists(p):
                try: os.remove(p)
                except: pass
        u['temp_photo'] = None; u['temp_data'] = {}; u['temp_pdf'] = None
    except Exception as e:
        logger.error(f"Template error: {e}")
        await update.callback_query.edit_message_text(f"❌ Dogoggora: {e}")

# ==================== CALLBACK HANDLER ====================
async def callback_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    q = update.callback_query
    await q.answer()
    data = q.data
    uid = update.effective_user.id
    if uid not in user_data: init_user(uid)
    u = user_data[uid]

    if data == "download_pdf":
        await download_pdf_callback(update, context)
    elif data == "converter":
        await converter_callback(update, context)
    elif data == "pay_menu":
        await pay_command(update, context)
    elif data == "settings_main":
        await setting_command(update, context)
    elif data == "menu":
        await menu_command(update, context)
    elif data == "setting_templates":
        await template_command(update, context)
    elif data == "setting_mirror":
        kb = [[InlineKeyboardButton("Mirrored", callback_data="mirror_on")],
              [InlineKeyboardButton("Not mirrored", callback_data="mirror_off")]]
        await q.edit_message_text("Position orientation:", reply_markup=InlineKeyboardMarkup(kb))
    elif data == "setting_color":
        kb = [[InlineKeyboardButton("🎨 Color", callback_data="color_mode")],
              [InlineKeyboardButton("⚫ Gray", callback_data="gray_mode")]]
        await q.edit_message_text("Color mode:", reply_markup=InlineKeyboardMarkup(kb))
    elif data == "setting_filetype":
        kb = [[InlineKeyboardButton("🖼️ Image", callback_data="filetype_image")],
              [InlineKeyboardButton("📄 PDF", callback_data="filetype_pdf")]]
        await q.edit_message_text("File format:", reply_markup=InlineKeyboardMarkup(kb))
    elif data == "setting_language":
        kb = [[InlineKeyboardButton("አማርኛ", callback_data="lang_am")],
              [InlineKeyboardButton("Afaan Oromoo", callback_data="lang_or")],
              [InlineKeyboardButton("English", callback_data="lang_en")]]
        await q.edit_message_text("Language:", reply_markup=InlineKeyboardMarkup(kb))
    elif data == "mirror_on": u['mirror'] = True; await q.edit_message_text("✅ Mirrored!")
    elif data == "mirror_off": u['mirror'] = False; await q.edit_message_text("✅ Not mirrored!")
    elif data == "color_mode": u['color_mode'] = 'color'; await q.edit_message_text("✅ Color!")
    elif data == "gray_mode": u['color_mode'] = 'gray'; await q.edit_message_text("✅ Gray!")
    elif data == "filetype_image": u['output_type'] = 'image'; await q.edit_message_text("✅ Image!")
    elif data == "filetype_pdf": u['output_type'] = 'pdf'; await q.edit_message_text("✅ PDF!")
    elif data == "lang_am": u['language'] = 'am'; await q.edit_message_text("✅ አማርኛ!")
    elif data == "lang_or": u['language'] = 'or'; await q.edit_message_text("✅ Afaan Oromoo!")
    elif data == "lang_en": u['language'] = 'en'; await q.edit_message_text("✅ English!")
    elif data.startswith("tmpl_"):
        num = int(data.split("_")[1])
        if u.get('state') == 'WAITING_TEMPLATE':
            await process_template(update, context, num)
        else:
            u['template'] = num
            await q.edit_message_text(f"✅ Template {num} filatame!")

